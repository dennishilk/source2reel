{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source2Reel Episode",
  "type": "object",
  "required": ["version", "title", "scenes"],
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string"},
    "slug": {"type": "string"},
    "summary": {"type": "string"},
    "presentation": {"type": "object", "properties": {"outro": {"$ref": "#/$defs/outro"}}},
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "narration", "evidence_refs"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["HERO","PROJECT_EVIDENCE","TERMINAL_EVIDENCE","HARDWARE_EVIDENCE","ARCHITECTURE_DIAGRAM","DATA_FLOW","TIMELINE","CODE","GRAPH","SECTION_TITLE","SUMMARY","OUTRO"]},
          "title": {"type": "string"},
          "narration": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "asset_ref": {"type": ["string","null"]},
          "annotations": {"type": "array"},
          "diagram": {"type": "object"},
          "media": {"type": "object", "properties": {"start_seconds": {"type": "number", "minimum": 0}}},
          "captions": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
          "pad_after_seconds": {"type": "number", "minimum": 0},
          "notes": {"type": "string"}
        },
        "allOf": [{"if": {"properties": {"type": {"enum": ["ARCHITECTURE_DIAGRAM", "DATA_FLOW", "TIMELINE"]}}, "required": ["type"]},
                   "then": {"properties": {"diagram": {"type": "object", "anyOf": [
                     {"required": ["nodes"], "properties": {"nodes": {"type": "array", "minItems": 2, "maxItems": 8}}},
                     {"required": ["steps"], "properties": {"steps": {"type": "array", "minItems": 2, "maxItems": 8}}}
                   ]}}, "required": ["diagram"]}}]
      }
    }
  },
  "$defs": {"outro": {"type": "object", "required": ["headline", "links"],
    "properties": {"eyebrow": {"type": "string"}, "headline": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
      "links": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "required": ["label", "url"],
        "properties": {"label": {"type": "string"}, "url": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}}}},
      "footer": {"type": "string"}}}}
}
